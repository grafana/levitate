{
  "name": "@grafana/levitate",
  "version": "0.17.3",
  "description": "A tool for helping to understand APIs exported and consumed by NPM packages (or any TypeScript code).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "bin": "dist/bin.js",
  "publishConfig": {
    "access": "public",
    "bin": {
      "levitate": "./dist/bin.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "setup-fixtures": "find ./fixtures -name _package.json -not -path '*/node_modules/*' -execdir bash -c 'cp _package.json package.json && touch yarn.lock && yarn install' \\;",
    "test": "yarn setup-fixtures && yarn build && LEVITATE_SILENT=true yarn vitest",
    "test:ci": "yarn test run",
    "build": "tsc && chmod +x ./dist/bin.js",
    "dev": "tsc --watch",
    "dev-compare": "nodemon --exec yarn run dev:compare",
    "dev-imports": "nodemon --exec yarn run dev:imports",
    "dev:compare": "run-s build fixtures:compare",
    "dev:imports": "run-s build fixtures:imports",
    "fixtures:compare": "NODE_DEBUG=levitate node ./dist/bin.js compare --prev @grafana/ui@canary --current @grafana/ui@latest",
    "fixtures:imports": "NODE_DEBUG=levitate node ./dist/bin.js list-imports --path ./fixtures/imports/package/src/module.ts --filters @grafana/ui @grafana/data",
    "lint": "eslint",
    "lint:fix": "yarn lint --fix && yarn prettier --write ./src",
    "knip": "knip",
    "knip:ci": "knip --reporter github-actions"
  },
  "keywords": [],
  "author": "Grafana Labs <team@grafana.com> (https://grafana.com)",
  "license": "Apache-2.0",
  "dependencies": {
    "@tsd/typescript": "^5.6.2",
    "@types/node": "^24.0.1",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "diff": "^9.0.0",
    "tar": "^7.4.3",
    "typescript": "5.9.3",
    "yargs": "^18.0.0",
    "yocto-spinner": "^1.2.0"
  },
  "devDependencies": {
    "@grafana/eslint-config": "10.0.0",
    "@stylistic/eslint-plugin-ts": "^4.2.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.51.0",
    "@typescript-eslint/parser": "8.51.0",
    "eslint": "9.39.4",
    "eslint-config-flat-gitignore": "2.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsdoc": "64.3.4",
    "eslint-plugin-no-only-tests": "3.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "knip": "^6.14.2",
    "nodemon": "3.1.14",
    "npm-run-all2": "9.0.3",
    "prettier": "3.7.4",
    "vitest": "4.1.4"
  },
  "nodemonConfig": {
    "watch": [
      "*.ts",
      "*.tsx",
      "package.json"
    ],
    "ext": "*",
    "ignore": [
      "repos/*",
      "dist/*"
    ],
    "events": {
      "start": "cls || clear"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grafana/levitate.git"
  },
  "bugs": {
    "url": "https://github.com/grafana/levitate/issues"
  },
  "homepage": "https://github.com/grafana/levitate#readme",
  "packageManager": "yarn@4.12.0"
}
